# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth2 — paths relativos al directorio job_alert_agent/
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Tu dirección de Gmail donde llegaron las alertas Y donde querés recibir el digest
YOUR_EMAIL=tu@gmail.com

# Cuántos días hacia atrás buscar alertas (el cron diario usa 1)
DAYS_LOOKBACK=1

# Máximo de ofertas a incluir en el digest
MAX_JOBS_IN_DIGEST=10
